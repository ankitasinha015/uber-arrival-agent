# Copy to .env and fill in. Never commit .env.

# Foursquare Places API — open restaurants + hours near the hotel
# Service Key from https://location.foursquare.com/developer/ (free tier).
# New Places API: Authorization: Bearer <key> + X-Places-Api-Version header,
# against places-api.foursquare.com.
FOURSQUARE_API_KEY=

# Maps API — airport -> hotel ETA (Google Maps or Mapbox)
# https://developers.google.com/maps/documentation/distance-matrix  (free credit)
MAPS_API_KEY=

# LLM — the agent reasoning
ANTHROPIC_API_KEY=

# Flight status and order placement are mocked — no keys needed.
# Mock event timelines live in scenarios/.
